#include<stdio.h>
#include<stdlib.h>
#include<string.h>
#include<unistd.h>
#include<sys/types.h>
#include<sys/wait.h>

int main()
{
   int pipe1[2], pipe2[2];
   int count = 0, i = 0;
   char input[80];
   pid_t pid2, pid3;

   if(pipe(pipe1) == -1 || pipe(pipe2) == -1)
   {
      perror("pipe creation failed");
      exit(1);
   }

   pid2 = fork();
   if(pid2 < 0)
   {
      printf("process creation failed\n");
      exit(1);
   }

   if(pid2 > 0)
   {
      close(pipe1[0]);
      close(pipe2[0]);
      close(pipe2[1]);

      printf("Enter the input string: ");
      fgets(input, sizeof(input), stdin);
      input[strcspn(input, "\n")] = '\0';

      write(pipe1[1], input, sizeof(input));
      close(pipe1[1]);
      wait(NULL);
   }
   else
   {
      pid3 = fork();
      if(pid3 < 0)
      {
         printf("Process creation failed\n");
         exit(1);
      }

      if(pid3 > 0)
      {
         close(pipe1[1]);
         close(pipe2[0]);

         read(pipe1[0], input, sizeof(input));
         close(pipe1[0]);

         for(i = 0; input[i] != '\0'; i++)
         {
            if(input[i]=='a'|| input[i]=='e'||input[i]=='i'||input[i]=='o'||input[i]=='u'||
               input[i]=='A'||input[i]=='E'||input[i]=='I'||input[i]=='O'||input[i]=='U')
            {
               count++;
            }
         }
         printf("Number of vowels: %d \n", count);

         write(pipe2[1], input, sizeof(input));
         write(pipe2[1], &count, sizeof(count));
         close(pipe2[1]);

         wait(NULL);
      }
      else
      {
         close(pipe1[0]);
         close(pipe1[1]);
         close(pipe2[1]);

         char received_str[80];
         int received_count;

         read(pipe2[0], received_str, sizeof(received_str));
         read(pipe2[0], &received_count, sizeof(received_count));
         close(pipe2[0]);

         int start = 0;
         int end = strlen(received_str) - 1;
         int flag = 1;

         while(start < end)
         {
            if(received_str[start] != received_str[end])
            {
               flag = 0;
               break;
            }
            start++;
            end--;
         }

         if(flag)
         {
            printf("It is a palindrome\n");
         }
         else
         {
            printf("Not a palindrome\n");
         }
      }
   }
   return 0;
}
